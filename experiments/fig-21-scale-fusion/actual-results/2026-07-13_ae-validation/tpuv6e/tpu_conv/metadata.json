{
  "experiment_name": "scope_paper_tpuv6e_attention",
  "experiment_config_path": "${BUNDLE_ROOT}/experiments/llmcompass_all_in_one/configs/paper_tpuv6e.json",
  "compile_mode": "heuristic-TPU",
  "batch_size": 1,
  "jobs": 8,
  "adjust_global_buffer_to_memory_capacity": true,
  "ignore_hbm_bottleneck": true,
  "ignore_onchip_io_bottleneck": false,
  "prefill_lengths": [
    2048,
    4096,
    8192,
    16384,
    32768
  ],
  "variants": [
    {
      "name": "flashattention",
      "label": "FlashAttention",
      "attention_variant": "flashattention"
    },
    {
      "name": "customsa",
      "label": "FlashAttention-CustomSA",
      "attention_variant": "flashattention_customsa"
    }
  ],
  "attention_env": {
    "LLMCOMPASS_INT8_MATCH_FP16_TILES": "0",
    "LLMCOMPASS_INT8_SOFTMAX_CONVERSION": "1",
    "LLMCOMPASS_CUSTOMSA_SEARCH_TILES": "0"
  },
  "model": {
    "name": "llama2_7b_attention",
    "hidden_size": 4096,
    "num_heads": 32
