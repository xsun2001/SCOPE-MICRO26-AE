# Copy this file to config/local.env and edit it for the reviewer machine.
# This file is read by Make; shell environment variables and command-line Make
# assignments with the same names are also supported.

# Use local to execute directly on the allocated GPU without Slurm.
EXECUTOR = local
WORKERS = 1

# Directory containing Llama-2-7b-hf, Llama-3-8b, facebook-opt-6.7b,
# Qwen2.5-7B, and Qwen3-8B.
MODEL_ROOT = /path/to/models

# Optional: reuse the four exact_* and four qmodel_* Table 5 directories.
# Leave empty to train the OST transforms and generate GPTQ models afresh.
TABLE5_CHECKPOINT_SOURCE = /path/to/table5/checkpoints

# PYTHON = /path/to/python
# PARTITION = acd_u
