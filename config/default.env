# Make-compatible defaults. Override any value in config/local.env or on the
# command line, for example: make fig-17 EXECUTOR=local WORKERS=1
EXECUTOR ?= slurm
PARTITION ?= acd_u
WORKERS ?= 15
PYTHON ?= $(if $(wildcard $(BUNDLE_ROOT)/.venv/bin/python),$(BUNDLE_ROOT)/.venv/bin/python,python3)
MODEL_ROOT ?= $(BUNDLE_ROOT)/models
TABLE5_CHECKPOINT_SOURCE ?=
PPL_TOLERANCE ?= 0.05
ACCURACY_TOLERANCE ?= 0.007
FUNCTION_RELATIVE_TOLERANCE ?= 0.20
FUNCTION_ABSOLUTE_TOLERANCE ?= 0.0002
RUN_ID ?= $(shell date +%F_%H%M%S)_scope_ae
RUN_ROOT ?= $(BUNDLE_ROOT)/runs/$(RUN_ID)
ARCHIVE ?= $(abspath $(BUNDLE_ROOT)/../scope-ae-bundle.tar.gz)
