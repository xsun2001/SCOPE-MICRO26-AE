        <mxCell id="13" value="SA GEMM Path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="264" width="150" height="24" as="geometry" />
        </mxCell>
        <mxCell id="14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="2100" height="110" as="geometry" />
        </mxCell>
        <mxCell id="15" value="SA Strip Rows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="384" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="2100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="17" value="State Update / Buffers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="504" width="180" height="24" as="geometry" />
        </mxCell>
        <mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="2100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Key Reuse Rules" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="634" width="140" height="24" as="geometry" />
        </mxCell>
        <mxCell id="20" value="InitIssue / InitWait&#xa;read coeff, Q, K^T, V, O, m, l&#xa;`2(H + 4N + 2)`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="21" value="PreloadKt&#xa;classical `LOAD_WEIGHT` preload of K^T&#xa;`N`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="22" value="RunFused (GEMM side)&#xa;launch Q, drain QK tail, capture aligned S rows&#xa;contributes `4N + H + 3` in the active two-strip RTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#1D4ED8;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="23" value="RunFused (strip coeff phase)&#xa;diagonal `LOAD_PINN` wave&#xa;deeper strip rows use shorter load windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="780" y="360" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="24" value="RunFused (strip compute phase)&#xa;stream `P = exp(S - m_new)` rows, overlap `V` preload, then issue `alpha = exp(m - m_new)`&#xa;active two-strip RTL: `N` P launches + `1` alpha launch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86EFAC;strokeColor=#15803D;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="1090" y="350" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="25" value="RunPV&#xa;stream ready P rows through resident V weights&#xa;`3N - 1`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#1D4ED8;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="1470" y="250" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Two-strip-only RTL: both strips stay resident, so nonlinear throughput remains full-width and there is no extra fallback tail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1650" y="350" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="27" value="Writeback + Done&#xa;write O, m, l&#xa;`N + 3`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1860" y="140" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Capture aligned S rows, compute `rowmax(S)`, update `m_new`, buffer `sRows`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="820" y="490" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Deskew `out_s_raw`, assemble `pRows` / `alphaRows`, accumulate `rowsum(P)` into `l_new`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#DC2626;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="1190" y="490" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="32" value="`O_new = alpha * O + PV`&#xa;updated from aligned PV output stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="1650" y="490" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="40" value="No dedicated strip-op bypass. `LOAD_PINN`, `PINN`, and `PINN_DRAIN` still use the skewed SA op pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="240" y="645" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="41" value="`PEStandard` treats all PINN-family ops as hold, so nonstrip rows stay quiescent during strip windows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="580" y="645" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="42" value="The wrapper deskews `out_s_raw` into aligned strip rows. Wrapper-visible strip latency is `N + 1` cycles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="920" y="645" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Two-strip-only RTL: each launch drives `N` strip lanes through the two resident strips." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="1260" y="645" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="44" value="`PINN_DRAIN` is not a standalone controller phase anymore. It is the in-state strip hold / drain behavior inside `RunFused`." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="1620" y="645" width="340" height="50" as="geometry" />
        </mxCell>
