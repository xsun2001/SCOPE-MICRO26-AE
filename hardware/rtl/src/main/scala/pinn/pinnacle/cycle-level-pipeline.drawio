        <mxCell id="2" value="Cycle-Level Pipeline View" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Current fused skewed controller. All ops stay on the skewed SA path; `PINN_DRAIN` is the strip-side hold/drain behavior inside `RunFused`." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Cycle formula (`waitDone` convention)&#xa;Active two-strip RTL: `T = 17N + 3H + 9`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1610" y="20" width="490" height="74" as="geometry" />
